# Copia este archivo a .env  (el .env ya está ignorado por git)

# Puerto del servidor HTTP
PORT=3000

# Fuente de datos: mock (única implementada por ahora).
# Más adelante: api_football | scraping
DATA_SOURCE=mock

# Conexión a MongoDB. Vacía por ahora: la app corre con datos mock en memoria.
# Ejemplo futuro: mongodb://localhost:27017/sports_predictions
MONGODB_URI=

# --- Ingesta desde API-Football (requiere MONGODB_URI) ---
# Key de https://dashboard.api-football.com (plan gratis: 100 peticiones/día).
API_FOOTBALL_KEY=
# IDs de liga separados por coma: 128 = Liga Profesional Argentina, 140 = La Liga.
API_FOOTBALL_LEAGUES=128,140
# Temporada (año en que empieza). El plan gratis solo da acceso a ciertas temporadas.
API_FOOTBALL_SEASON=2026
# true para programar la ingesta automática (por defecto está apagada).
INGEST_ENABLED=true
# Expresión cron; por defecto cada 6 horas. Cada liga gasta 2 peticiones por corrida.
INGEST_CRON=0 */6 * * *
# true para correr una ingesta apenas arranca la app.
INGEST_ON_START=true
