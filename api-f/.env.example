# Copia este archivo a .env  (el .env ya está ignorado por git)

# Puerto del servidor HTTP
PORT=3000

# Fuente de datos: mock (única implementada por ahora).
# Más adelante: scraping
DATA_SOURCE=mock

# Conexión a MongoDB. Vacía por ahora: la app corre con datos mock en memoria.
# Ejemplo futuro: mongodb://localhost:27017/sports_predictions
MONGODB_URI=

# --- Ingesta desde football-data.org (requiere MONGODB_URI) ---
# Token gratis en https://www.football-data.org/client/register (se envía en el header X-Auth-Token).
# Plan gratis: 10 peticiones/minuto, solo temporada actual, marcadores con retraso.
FOOTBALL_DATA_API_KEY=
# Códigos de competición separados por coma (plan gratis): PD = La Liga, PL = Premier League,
# BL1 = Bundesliga, SA = Serie A, FL1 = Ligue 1, DED = Eredivisie, PPL = Primeira Liga,
# ELC = Championship, BSA = Brasileirão, CL = Champions League.
FOOTBALL_DATA_COMPETITIONS=PD
# Año en que empieza la temporada (2026 = 2026/27). Vacío = temporada actual de la API.
FOOTBALL_DATA_SEASON=
# true para programar la ingesta automática (por defecto está apagada).
INGEST_ENABLED=false
# Expresión cron; por defecto cada 6 horas. Cada competición gasta 2 peticiones por corrida.
INGEST_CRON=0 */6 * * *
# true para correr una ingesta apenas arranca la app.
INGEST_ON_START=false
